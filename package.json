{
  "name": "albion-market-bot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:data": "npm run build --workspace @albion/core",
    "build:api-limiter": "npm run build --workspace @albion/api-limiter",
    "build:web": "npm run build --workspace @albion/web",
    "build:bot": "npm run build --workspace @albion/bot",
    "test:bot": "node --experimental-strip-types --test apps/bot/test/worker.test.mjs",
    "test:api-cache": "node --experimental-strip-types --test packages/core/test/api-cache.test.mjs",
    "test:api-rate-limit": "node --experimental-strip-types --test apps/api-limiter/test/worker.test.mjs apps/web/test/api-rate-limit.test.mjs",
    "test:web-format": "node --experimental-strip-types --test apps/web/test/format.test.mjs",
    "test:web-validation": "node --experimental-strip-types --test apps/web/test/api-validation.test.mjs",
    "dev:web": "npm run dev --workspace @albion/web",
    "dev:bot": "npm run dev --workspace @albion/bot",
    "bot:register": "npm run register --workspace @albion/bot",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
